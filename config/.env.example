# Copy to .env at the repository root (git-ignored) or export these variables.
# Passwords of the backend's seeded test accounts (see contracts/test-data.yaml for the accounts).
# For the local Mobile Test Playground seed, the values are the app team's published LOCAL-ONLY
# test credentials (app repo: docs/test-credentials.md). Never put real credentials here.
MTF_PASSWORD_CUSTOMER=
MTF_PASSWORD_QA=
MTF_PASSWORD_ADMIN=
MTF_PASSWORD_LOCKED=

# Optional: AI planner provider (plans and execution never need it).
ANTHROPIC_API_KEY=
# MTF_AI_MODEL=claude-opus-5-5

# Opt-in for non-local environments (staging). Production is always refused.
# MTF_ALLOW_REMOTE_ENV=1
